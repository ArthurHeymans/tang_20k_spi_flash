// Tang Nano 20K Constraints File for SPI Flash Emulator
// Board: Sipeed Tang Nano 20K
// FPGA: Gowin GW2AR-LV18QN88C8/I7

// ============================================================
// Clock Input (27MHz crystal oscillator)
// ============================================================
IO_LOC "clk_27mhz" 4;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ============================================================
// User LEDs (accent active low)
// ============================================================
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// ============================================================
// User Buttons
// ============================================================
IO_LOC "btn_s1" 88;
IO_LOC "btn_s2" 87;
IO_PORT "btn_s1" IO_TYPE=LVCMOS33;
IO_PORT "btn_s2" IO_TYPE=LVCMOS33;

// ============================================================
// UART via BL616 Debugger
// ============================================================
IO_LOC "uart_rx" 70;
IO_LOC "uart_tx" 69;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;

// ============================================================
// SPI Flash Emulation Interface
// Using GPIO pins on the edge connector (active tested pins)
// Reference: Tang Nano 20K pinout from Sipeed wiki
// ============================================================

// SPI Chip Select (active low) - Pin 73
// Added HYSTERESIS=ON for better noise immunity
IO_LOC "spi_cs_pin" 73;
IO_PORT "spi_cs_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP HYSTERESIS=ON;

// SPI Clock - Pin 74
// Added HYSTERESIS=ON for clean clock edges
// Added BUFG for global clock routing
IO_LOC "spi_clk_pin" 74;
IO_PORT "spi_clk_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP HYSTERESIS=ON;
CLOCK_LOC "spi_clk_pin" BUFG;

// SPI MOSI (Master Out Slave In) - Pin 75
// Added HYSTERESIS=ON for better noise immunity during long page writes
// Added PULL_MODE=UP to prevent floating input
IO_LOC "spi_mosi_pin" 75;
IO_PORT "spi_mosi_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP HYSTERESIS=ON;

// SPI MISO (Master In Slave Out) - Pin 76
IO_LOC "spi_miso_pin" 76;
IO_PORT "spi_miso_pin" IO_TYPE=LVCMOS33 DRIVE=8 SLEW_RATE=FAST;

// SPI Power Detection (active high when SPI master is powered) - Pin 77
IO_LOC "spi_power_pin" 77;
IO_PORT "spi_power_pin" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Debug output - Pin 27
IO_LOC "spi_debug_pin" 27;
IO_PORT "spi_debug_pin" IO_TYPE=LVCMOS33 DRIVE=8;

// ============================================================
// Internal SDRAM (GW2AR-18 built-in 64Mbit / 8MB)
// 32-bit data bus, directly connected to FPGA die via wire bonding
// Pin mappings from apicula documentation - uses IOB location names
// Bank voltage for banks 2 and 7 must be 3.3V
// ============================================================

// SDRAM Clock
IO_LOC "O_sdram_clk" IOR11B;
IO_PORT "O_sdram_clk" IO_TYPE=LVCMOS33;

// SDRAM Control
IO_LOC "O_sdram_cke" IOL13A;
IO_PORT "O_sdram_cke" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_cs_n" IOL14B;
IO_PORT "O_sdram_cs_n" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_cas_n" IOL14A;
IO_PORT "O_sdram_cas_n" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_ras_n" IOL13B;
IO_PORT "O_sdram_ras_n" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_wen_n" IOL12B;
IO_PORT "O_sdram_wen_n" IO_TYPE=LVCMOS33;

// SDRAM Address (directly directly directly)
IO_LOC "O_sdram_addr[0]" IOR14A;
IO_PORT "O_sdram_addr[0]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[1]" IOR13B;
IO_PORT "O_sdram_addr[1]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[2]" IOR14B;
IO_PORT "O_sdram_addr[2]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[3]" IOR15A;
IO_PORT "O_sdram_addr[3]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[4]" IOL16B;
IO_PORT "O_sdram_addr[4]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[5]" IOL17B;
IO_PORT "O_sdram_addr[5]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[6]" IOL16A;
IO_PORT "O_sdram_addr[6]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[7]" IOL17A;
IO_PORT "O_sdram_addr[7]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[8]" IOL15B;
IO_PORT "O_sdram_addr[8]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[9]" IOL15A;
IO_PORT "O_sdram_addr[9]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_addr[10]" IOR12B;
IO_PORT "O_sdram_addr[10]" IO_TYPE=LVCMOS33;

// SDRAM Bank Address
IO_LOC "O_sdram_ba[0]" IOR13A;
IO_PORT "O_sdram_ba[0]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_ba[1]" IOR12A;
IO_PORT "O_sdram_ba[1]" IO_TYPE=LVCMOS33;

// SDRAM Data Mask
IO_LOC "O_sdram_dqm[0]" IOL12A;
IO_PORT "O_sdram_dqm[0]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_dqm[1]" IOR11A;
IO_PORT "O_sdram_dqm[1]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_dqm[2]" IOL18A;
IO_PORT "O_sdram_dqm[2]" IO_TYPE=LVCMOS33;

IO_LOC "O_sdram_dqm[3]" IOR15B;
IO_PORT "O_sdram_dqm[3]" IO_TYPE=LVCMOS33;

// SDRAM Data Bus (32-bit)
IO_LOC "IO_sdram_dq[0]" IOL3A;
IO_PORT "IO_sdram_dq[0]" IO_TYPE=LVCMOS33;

IO_LOC "IO_sdram_dq[1]" IOL3B;
IO_PORT "IO_sdram_dq[1]" IO_TYPE=LVCMOS33;

